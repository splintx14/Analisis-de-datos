# Copia este archivo como .env y cambia los valores.
# El archivo .env NO se sube a GitHub (está en .gitignore).

POSTGRES_USER=datainsights
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=datainsights
POSTGRES_PORT=5432

# Debe coincidir con los valores de arriba
DATABASE_URL=postgresql://datainsights:cambia_esta_clave@localhost:5432/datainsights

# Cadena larga y aleatoria para firmar sesiones (genera una con: openssl rand -base64 48)
SESSION_SECRET=cambia_esto_por_un_valor_largo_y_aleatorio
